<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="Client.Views.CustomersView"
             x:DataType="vm:CustomersViewModel">
  <Design.DataContext>
    <vm:CustomersViewModel></vm:CustomersViewModel>
  </Design.DataContext>

  <StackPanel>
    <TextBlock Classes="pageTitle" Text="{Binding PageTitle}"/>

    <Border BorderBrush="White" BorderThickness="0 0 0 1" Padding="0 50 0 5">
      <Grid ColumnDefinitions="100,150,150,300,150,300,200,*">
        <Label Grid.Column="0" Content="Kundnr" />
        <Label Grid.Column="1" Content="Förnamn"/>
        <Label Grid.Column="2" Content="Efternamn" />
        <Label Grid.Column="3" Content="E-Post" />
        <Label Grid.Column="4" Content="Telefon" />
        <Label Grid.Column="5" Content="Adress" />
        <Label Grid.Column="6" Content="Postnr" />
        <Label Grid.Column="7" Content="Ort" />
      </Grid>
    </Border>
    <ItemsControl ItemsSource="{Binding Customers}" Margin="0 10 0 0">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="100,150,150,300,150,300,200,*">
            <Label Grid.Column="0" Content="{Binding Id}" />
            <Label Grid.Column="1" Content="{Binding FirstName}" />
            <Label Grid.Column="2" Content="{Binding LastName}" />
            <Label Grid.Column="3" Content="{Binding Email}" />
            <Label Grid.Column="4" Content="{Binding Phone}" />
            <Label Grid.Column="5" Content="{Binding Addresses[0].AddressLine}" />
            <Label Grid.Column="6" Content="{Binding Addresses[0].PostalCode.Code}" />
            <Label Grid.Column="7" Content="{Binding Addresses[0].PostalCode.City.Name}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
